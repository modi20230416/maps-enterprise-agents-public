# Documentation only: this file is NOT loaded automatically.
# Set these variables in the process environment, or use run_llm.ps1 for the key.
# The example host is intentionally non-routable; replace it with your provider.
MAPS_LLM_BASE_URL=https://llm.example.invalid/v1
MAPS_LLM_API=chat_completions
MAPS_LLM_MODEL=YOUR_MODEL_ID
MAPS_LLM_API_KEY=
MAPS_LLM_CHAT_TOKEN_PARAMETER=max_tokens
MAPS_LLM_STRICT_TOOLS=false
MAPS_LLM_SEND_PARALLEL_TOOL_CALLS=false
MAPS_LLM_TIMEOUT=25
MAPS_LLM_TOTAL_TIMEOUT=120
MAPS_LLM_MAX_ROUNDS=12
MAPS_LLM_MAX_TOOL_CALLS=24
# Optional checkpoint generated locally by train-drl, used only by the experiment:
MAPS_DRL_CHECKPOINT=
